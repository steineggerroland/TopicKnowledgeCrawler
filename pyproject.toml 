[project]
name = "content_collector"
version = "0.1.0"
description = "A content collector and summarizer for RSS feeds using Python and LLMs."
authors = [
    { name="Roland H. Steinegger", email="roland@neurospicy.icu" }
]
requires-python = ">=3.10"
dependencies = [
    "feedparser>=6.0.10",
    "requests>=2.31.0",
    "openai>=1.0.0",
    "beautifulsoup4>=4.12.0",
    "python-dotenv>=1.0.0"
]

[project.optional-dependencies]
dev = ["pytest>=7.0", "black>=23.0", "flake8>=6.0"]

[tool.black]
line-length = 88

[build-system]
requires = ["setuptools>=61.0"]
build-backend = "setuptools.build_meta"