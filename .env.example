# TopicKnowledgeCrawler local/n8n environment example.
# Copy to .env in environments that need these values and adjust locally.

# Keep tldextract from writing its cache into user-global locations during tests.
TLDEXTRACT_CACHE=/tmp/tkcrawler-tldextract-cache

# n8n / infl0 integration.
INFL0_BASE_URL=http://localhost:3000
CRAWLER_HOST_PATH=/absolute/path/to/TopicKnowledgeCrawler

# n8n external runner setup.
RUNNER_SECRET=change-me
N8N_RUNNERS_EXTERNAL_ALLOW=tkcrawler,feedparser,trafilatura,requests,bs4,lxml,tldextract
TOPIC_CRAWLER_ROOT=/data/TopicKnowledgeCrawler
# Fallback for development mounts. Prefer installing tkcrawler with pip install -e.
PYTHONPATH=/data/TopicKnowledgeCrawler/src:/data/TopicKnowledgeCrawler
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=n8n
POSTGRES_NON_ROOT_PASSWORD=change-me
TZ=Europe/Berlin

# Optional. LLM enrichment is orchestrated by n8n AI nodes, not by tkcrawler.
# Keep this here so runner/workflow environments document the provider choice.
LLM_PROVIDER=ollama
